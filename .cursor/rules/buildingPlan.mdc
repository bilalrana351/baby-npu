Core Components Design
1. Registers (registers.hpp)
class RegisterFile {
    int32_t scalar[32];      // x0-x31 (x0 hardwired to 0)
    int32_t vector[8][4];    // V0-V7, each 4 x 32-bit
public:
    int32_t readScalar(uint8_t reg);
    void writeScalar(uint8_t reg, int32_t value);
    void readVector(uint8_t reg, int32_t out[4]);
    void writeVector(uint8_t reg, const int32_t in[4]);
};
2. Memory (memory.hpp)
class Memory {
    std::vector<uint8_t> data;  // Byte-addressable, default 64KB
public:
    uint32_t readWord(uint32_t addr);
    void writeWord(uint32_t addr, uint32_t value);
    void read128(uint32_t addr, int32_t out[4]);   // For VLOAD
    void write128(uint32_t addr, const int32_t in[4]); // For VSTORE
};
3. Instruction Decoder (decoder.hpp)
struct DecodedInstr {
    InstrType type;     // R, I, S, B, J, U
    uint8_t opcode;
    uint8_t rd, rs1, rs2;
    uint8_t funct3, funct7;
    int32_t imm;
    bool isNPU;         // true if opcode == 0x77
    NPUOp npuOp;        // VLOAD, VADD, VMAC, etc.
};

class Decoder {
public:
    DecodedInstr decode(uint32_t instruction);
};
4. CPU Base Interface (cpu_base.hpp)
class CPUBase {
protected:
    RegisterFile regs;
    Memory& mem;
    uint32_t pc;
    Logger& logger;
public:
    virtual void run() = 0;           // Execute until halt
    virtual void step() = 0;          // Execute one instruction
    virtual Stats getStats() = 0;     // Cycle count, CPI, etc.
};
5. Single-Cycle CPU (single_cycle.hpp)
class SingleCycleCPU : public CPUBase {
public:
    void step() override {
        // IF: Fetch instruction
        uint32_t instr = mem.readWord(pc);
        
        // ID: Decode
        DecodedInstr decoded = decoder.decode(instr);
        
        // EX: Execute (ALU or NPU)
        // MEM: Memory access
        // WB: Write back
        
        // All in one cycle
        cycleCount++;
    }
};
